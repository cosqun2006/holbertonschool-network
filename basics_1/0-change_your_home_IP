#!/usr/bin/env bash
# Configures local host file to map localhost to 127.0.0.2 and facebook.com to 8.8.8.8

# Replace 127.0.0.1 with 127.0.0.2 without breaking mounted file
sed 's/127\.0\.0\.1/127\.0\.0\.2/g' /etc/hosts > /tmp/hosts.tmp && cat /tmp/hosts.tmp > /etc/hosts

# Add or replace facebook.com entry
if grep -q "facebook.com" /etc/hosts; then
    sed 's/.*facebook\.com/8.8.8.8 facebook.com/g' /etc/hosts > /tmp/hosts.tmp && cat /tmp/hosts.tmp > /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi

rm -f /tmp/hosts.tmp
